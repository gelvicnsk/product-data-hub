# Copier ce fichier en .env puis remplir les mots de passe :
#   cp .env.example .env
# Le fichier .env n'est jamais commité (voir .gitignore).

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=product_hub
POSTGRES_USER=hub_admin
POSTGRES_PASSWORD=

# Rôles de l'API (créés par infra/postgres/init.sql) :
#   api_reader : lecture seule des marts ; api_writer : écriture dans le schéma app uniquement
API_DB_USER=api_reader
API_DB_PASSWORD=
API_WRITER_DB_USER=api_writer
API_WRITER_DB_PASSWORD=

# Base dédiée aux tests d'intégration (jamais la base de développement)
POSTGRES_TEST_DB=product_hub_test

# --- Simulation des sources ---------------------------------------------------
SIM_SEED=42
SIM_START_DATE=2026-10-01
SIM_DAYS=30
LANDING_DIR=data/landing

# --- Faux CRM (type Salesforce) -----------------------------------------------
MOCK_CRM_PORT=8010
CRM_API_URL=http://localhost:8010
CRM_PAGE_SIZE=200

# --- API ------------------------------------------------------------------------
# 8001 est pris par l'API du projet HPC Portfolio Data Hub
API_PORT=8002
# false = API sans authentification (démo locale uniquement)
AUTH_ENABLED=true

# --- Keycloak (authentification de l'API) --------------------------------------
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_PASSWORD=
# utilisateurs de démo du realm product-hub : alice (reader) et bob (data_steward)
KC_DEMO_READER_PASSWORD=
KC_DEMO_STEWARD_PASSWORD=

# --- Airflow ----------------------------------------------------------------------
AIRFLOW_PORT=8082

# --- Utilisateur des conteneurs (évite des fichiers appartenant à root) --------
# Remplir avec la sortie de : id -u  et  id -g
HOST_UID=1000
HOST_GID=1000
